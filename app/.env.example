# mock (default): the contract's own examples, no network.
# live: the core at /api on the same origin.
VITE_API_MODE=mock
# true: the bill screen calls the core's bill endpoints; only with VITE_API_MODE=live. Anything else: the mock.
VITE_BILL_LIVE=
# Dev server only, live mode: where to proxy /api, for example http://localhost:8000
VITE_API_PROXY=
