ASK_RATE_LIMIT_CUSTOMER_PER_MIN=
TRUSTED_PROXIES=
VALIO_PORTAL_URL=
VALIO_PORTAL_PASSWORD=
VALIO_API_KEY=
EXA_API_KEY=
CONTEXT_DEV_API_KEY=
OXYLABS_WEB_API_KEY=
CALA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Gemini model id used by the coach, pinned for the demo
GEMINI_MODEL=
NVIDIA_API_KEY=
HOSTINGER_AI_ROUTER_KEY=
ELEVENLABS_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=
HOSTINGER_API_TOKEN=
CRACI_API_TOKEN=
