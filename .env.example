# Copy to .env and fill in. Never commit .env.
DATABASE_URL=
DEMO_TODAY=2026-09-30
# Tool-result cache (#86): off, memory or disk (default; var/cache/tools.sqlite3, filled by the warm-up)
TOOL_CACHE=
# Results kept in memory (default 512)
TOOL_CACHE_MAX_ENTRIES=
# Directory of the disk layer (default var/cache under the repository root)
TOOL_CACHE_DIR=
# Comma-separated origins allowed to call the core API; empty = local dev servers (ports 3000 and 5173)
CORS_ORIGINS=
# Answer pipeline (core/agent): audit records and the /api/ask rate limits
AUDIT_LOG_DIR=
AUDIT_API=
ASK_RATE_LIMIT_PER_MIN=
ASK_RATE_LIMIT_GLOBAL_PER_MIN=
ASK_RATE_LIMIT_CUSTOMER_PER_MIN=
TRUSTED_PROXIES=
VALIO_PORTAL_URL=
VALIO_PORTAL_PASSWORD=
VALIO_API_KEY=
EXA_API_KEY=
CONTEXT_DEV_API_KEY=
OXYLABS_WEB_API_KEY=
CALA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Gemini model id: leave empty. The pinned id is the default in core/agent/gemini.py; set it only as a
# process environment variable for an experiment (a 12+ character value in .env blocks commits).
GEMINI_MODEL=
# Gemini response cache under var/gemini-cache: on (default), off, or replay (read only, never the network)
GEMINI_CACHE=
# Requests to the Gemini API in any rolling 24 hours (default 300; 0 turns the model off). See README, "Model settings".
MODEL_DAILY_BUDGET=
NVIDIA_API_KEY=
HOSTINGER_AI_ROUTER_KEY=
ELEVENLABS_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=
HOSTINGER_API_TOKEN=
CRACI_API_TOKEN=
AIVEN_TOKEN=
SPREAD_URL=
SPREAD_KEY=
# Customers the API serves: empty or personas = only core/config/personas.yaml (default, dev service);
# all = every customer of the data (local eval runs only)
DEMO_CUSTOMERS=
# Spike reviews (the coach asks about one spending spike): empty or on = on; off = no review is created
# and no label is read, so the published numbers are served
SPIKE_REVIEWS=
