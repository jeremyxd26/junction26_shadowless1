# Copy to .env and fill in. Never commit .env.
DATABASE_URL=
DEMO_TODAY=2026-09-30
# Tool-result cache (#86): off, memory or disk (default; var/cache/tools.sqlite3, filled by the warm-up)
TOOL_CACHE=
# Results kept in memory (default 512)
TOOL_CACHE_MAX_ENTRIES=
# Directory of the disk layer (default var/cache under the repository root)
TOOL_CACHE_DIR=
# Comma-separated origins allowed to call the core API; empty = local dev servers (ports 3000 and 5173)
CORS_ORIGINS=
# Spike reviews (the coach asks about one spending spike): empty or on = on; off = no review is created
# and no label is read, so the published numbers are served
SPIKE_REVIEWS=
VALIO_PORTAL_URL=
VALIO_PORTAL_PASSWORD=
VALIO_API_KEY=
EXA_API_KEY=
CONTEXT_DEV_API_KEY=
OXYLABS_WEB_API_KEY=
CALA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Gemini model id used by the coach, pinned for the demo
GEMINI_MODEL=
NVIDIA_API_KEY=
HOSTINGER_AI_ROUTER_KEY=
ELEVENLABS_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=
HOSTINGER_API_TOKEN=
CRACI_API_TOKEN=
AIVEN_TOKEN=
SPREAD_URL=
SPREAD_KEY=
# Customers the API serves: empty or personas = only core/config/personas.yaml (default, dev service);
# all = every customer of the data (local eval runs only)
DEMO_CUSTOMERS=
