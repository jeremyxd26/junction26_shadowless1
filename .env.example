# Copy to .env and fill in. Never commit .env.
DATABASE_URL=
DEMO_TODAY=2026-09-30
# Tool-result cache (#86): off, memory or disk (default; var/cache/tools.sqlite3, filled by the warm-up)
TOOL_CACHE=
# Results kept in memory (default 512)
TOOL_CACHE_MAX_ENTRIES=
# Directory of the disk layer (default var/cache under the repository root)
TOOL_CACHE_DIR=
# Seconds a request waits for another request's computation of the same result (default 5), then computes itself
TOOL_CACHE_WAIT_S=
# Comma-separated origins allowed to call the core API; empty = local dev servers (ports 3000 and 5173)
CORS_ORIGINS=
# Answer pipeline (core/agent): audit records and the /api/ask rate limits
AUDIT_LOG_DIR=
AUDIT_API=
ASK_RATE_LIMIT_PER_MIN=
ASK_RATE_LIMIT_GLOBAL_PER_MIN=
ASK_RATE_LIMIT_CUSTOMER_PER_MIN=
# The hard ceiling of /api/ask (#232): only this answers 429; the three above only switch off the model
ASK_HARD_LIMIT_PER_MIN=
ASK_HARD_LIMIT_GLOBAL_PER_MIN=
TRUSTED_PROXIES=
# Most database connections the core service's pool opens (1-20); empty = 10
DB_POOL_MAX=
# 1 serves the interactive API docs (/docs, /redoc, /openapi.json); local development only, off when empty
API_DOCS=
VALIO_PORTAL_URL=
VALIO_PORTAL_PASSWORD=
VALIO_API_KEY=
EXA_API_KEY=
CONTEXT_DEV_API_KEY=
OXYLABS_WEB_API_KEY=
CALA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Gemini model id: leave empty. The pinned id is the default in core/agent/gemini.py; set it only as a
# process environment variable for an experiment (a 12+ character value in .env blocks commits).
GEMINI_MODEL=
# Per role (#341), as process variables like GEMINI_MODEL (a model id in .env blocks commits): a model for
# the planner or the composer (default GEMINI_MODEL), thinking default|minimal|low|medium|high (default low,
# as the model accepts), and seconds per call (planner 9, composer 5). See README, "Model settings".
GEMINI_PLANNER_MODEL=
GEMINI_COMPOSER_MODEL=
GEMINI_PLANNER_THINKING=
GEMINI_COMPOSER_THINKING=
GEMINI_PLANNER_TIMEOUT_S=
GEMINI_COMPOSER_TIMEOUT_S=
# Gemini response cache under var/gemini-cache: on (default), off, or replay (read only, never the network)
GEMINI_CACHE=
# Requests to the Gemini API in any rolling 24 hours (default 300; 0 turns the model off). See README, "Model settings".
MODEL_DAILY_BUDGET=
NVIDIA_API_KEY=
HOSTINGER_AI_ROUTER_KEY=
ELEVENLABS_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=
HOSTINGER_API_TOKEN=
CRACI_API_TOKEN=
AIVEN_TOKEN=
SPREAD_URL=
SPREAD_KEY=
# Customers the API serves: empty or personas = only core/config/personas.yaml (default, dev service);
# all = every customer of the data (local eval runs only)
DEMO_CUSTOMERS=
# Spike reviews (the coach asks about one spending spike): empty or on = on; off = no review is created
# and no label is read, so the published numbers are served
SPIKE_REVIEWS=
# Viewer cookie (#144): Secure by default; false only for local development over http
VIEWER_COOKIE_SECURE=
# POST /api/baskets/label limits, 0 = off. A venue's Wi-Fi is one client address, so the address limits are
# sized for a room; the per-viewer limit and the session cap are what protect.
# Label writes per minute from one client address (default 120): bounds one address's load on the database
LABEL_RATE_LIMIT_PER_MIN=
# Label writes per minute from one address for one customer (default 60): one address cannot hammer a persona
LABEL_RATE_LIMIT_CUSTOMER_PER_MIN=
# Label writes per minute from one viewer session (default 10): what keeps a single viewer (or script) in check
LABEL_RATE_LIMIT_VIEWER_PER_MIN=
# New viewer sessions per hour from one client address (default 1000); the session cap is the real bound
LABEL_NEW_SESSIONS_PER_HOUR=
