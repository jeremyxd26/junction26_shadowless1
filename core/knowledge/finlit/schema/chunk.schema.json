{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "sentti-rag/chunk.schema.json",
 "title": "Chunk",
 "description": "One retrievable unit in one language. Embed `text`; filter on lang, age_bands, topics, licence_class; rank with priority.",
 "type": "object",
 "required": [
  "id",
  "kind",
  "source_id",
  "lang",
  "title",
  "text",
  "topic",
  "topics",
  "age_bands",
  "tier",
  "official",
  "priority",
  "licence_class",
  "source_url",
  "retrieved_at",
  "attribution",
  "keywords"
 ],
 "properties": {
  "id": {
   "type": "string"
  },
  "kind": {
   "type": "string",
   "enum": [
    "source_card",
    "page_text",
    "fact"
   ]
  },
  "source_id": {
   "type": "string"
  },
  "fact_id": {
   "type": "string"
  },
  "lang": {
   "type": "string",
   "enum": [
    "en",
    "fi"
   ]
  },
  "title": {
   "type": "string"
  },
  "text": {
   "type": "string",
   "minLength": 1
  },
  "section": {
   "type": "string"
  },
  "position": {
   "type": "integer",
   "minimum": 1
  },
  "topic": {
   "type": "string"
  },
  "topics": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  },
  "age_bands": {
   "type": "array",
   "items": {
    "type": "string",
    "enum": [
     "0-12",
     "13-17",
     "18-24",
     "25-34",
     "35-44",
     "45-54",
     "55-64",
     "65-74",
     "75+",
     "all"
    ]
   },
   "minItems": 1
  },
  "lesson_keys": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "tier": {
   "type": "string",
   "enum": [
    "authority",
    "public_education",
    "nonprofit",
    "industry_association",
    "bank",
    "academic",
    "international_org",
    "other"
   ]
  },
  "official": {
   "type": "boolean"
  },
  "priority": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "licence_class": {
   "type": "string",
   "enum": [
    "open_attribution",
    "open_share_alike",
    "noncommercial_only",
    "terms_allow_reuse",
    "registration_required",
    "all_rights_reserved",
    "not_stated"
   ]
  },
  "source_url": {
   "type": "string",
   "minLength": 8
  },
  "retrieved_at": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "attribution": {
   "type": "string"
  },
  "keywords": {
   "type": "object",
   "required": [
    "en",
    "fi"
   ],
   "properties": {
    "en": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "fi": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 }
}
