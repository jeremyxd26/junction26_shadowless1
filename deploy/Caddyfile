# Reverse proxy and static file server in front of the core service (rendered to /etc/caddy/Caddyfile by
# deploy/remote-deploy.sh). __SITE__ is replaced with the contents of /etc/shadowless1/site, one line
# that names the host(s):
#   135-181-63-178.sslip.io                          automatic HTTPS (Let's Encrypt)
#   135-181-63-178.sslip.io, sentti.jeremyxd.dev     several names; add one only after its DNS record
#                                                    points at the instance (failed attempts hit rate limits)
#   http://135-181-63-178.sslip.io                   plain HTTP, if no certificate can be issued
# The API and the health checks go to the core service. Every other path is the app: the static build
# of app/ for the deployed commit (/opt/shadowless1/app/current, a link set by remote-deploy.sh). Client
# routes such as /chat fall back to index.html. Without an app build (a commit without app/package.json)
# those paths answer 404.
__SITE__ {
	encode gzip

	# Security headers on every response (#102), Caddy's own errors included: set at once, before any
	# handler runs. HSTS without `preload`: the parent domain is shared.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	# Deleting Server also removes the core's own `server: uvicorn`. A deletion is applied when the
	# response is written, so it is kept apart (it would defer the headers above too) and repeated for
	# Caddy's own error responses below.
	header -Server

	handle_errors {
		header -Server
		# An API body over the limit (request_body below): Caddy 2.6 reports it as 413 only for a chunked
		# body; with a Content-Length the proxy wraps it in a 502. Both become 413. Other errors keep
		# their status (a 502 when the core is down stays 502).
		@too_large expression `{http.error.message}.contains("request body too large")`
		respond @too_large "" 413
		respond "" {err.status_code}
	}

	# The core answers JSON only: nothing may load, run or frame it.
	@core path /api/* /healthz /readyz
	handle @core {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		# The largest legitimate body is a question of 500 characters in a small JSON envelope; anything
		# over 64 KB is refused with 413. A declared Content-Length over 65536 is refused before any byte
		# goes to the service; a chunked body is cut at 64 KB by request_body (handle_errors makes it 413).
		@oversized header_regexp Content-Length ^(6553[7-9]|655[4-9][0-9]|65[6-9][0-9]{2}|6[6-9][0-9]{3}|[7-9][0-9]{4}|[1-9][0-9]{5,})$
		respond @oversized "" 413
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:8000
	}

	# Vite puts content-hashed files under /assets/: they never change, so they are cached for a year.
	# Anything else here (a missing asset, the directory /assets/ itself) is a plain 404 that is not
	# stored, never index.html (that would be cached as the asset). The three matchers do not overlap on
	# Cache-Control, so the order Caddy gives the header directives does not matter.
	handle /assets/* {
		root * /opt/shadowless1/app/current
		@hashed {
			file
			not path */
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@missing not file
		header @missing Cache-Control "no-store"
		@directory path */
		header @directory Cache-Control "no-store"
		file_server
	}

	# Everything else: a file of the build, or index.html for a client route. Revalidated on every load,
	# so a deploy is picked up at once. The app's CSP (app owner's needs on #102): its own scripts, styles
	# and fonts only (the Vite build emits files, no inline script), images from itself or data: URIs (so
	# rendered markdown cannot load an outside image), API calls to its own origin only. Framing only by
	# its own origin: the S-mobiili WebView loads the module top-level and is not affected.
	handle {
		root * /opt/shadowless1/app/current
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		try_files {path} /index.html
		file_server
	}
}
